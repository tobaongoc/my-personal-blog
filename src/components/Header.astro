---
import { SITE_TITLE } from '../consts';
import { navigation, pathFor } from '../data/navigation';
const current = Astro.url.pathname;
const isCurrent = (slug: string) => {
  const target = pathFor(slug);
  return slug === '' ? current === target || current === target.slice(0,-1) : current === target || current.startsWith(target);
};
---
<header class="site-header">
  <nav class="site-nav" aria-label="Điều hướng chính">
    <h2 class="site-brand"><a href={pathFor('')}>{SITE_TITLE}</a></h2>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="nie-menu" aria-label="Mở menu"><span></span><span></span><span></span></button>
    <div class="menu-links" id="nie-menu">
      {navigation.map(item => <a href={pathFor(item.slug)} class={isCurrent(item.slug) ? 'active' : ''} aria-current={isCurrent(item.slug) ? 'page' : undefined}>{item.label}</a>)}
    </div>
  </nav>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const links = document.querySelector<HTMLElement>('#nie-menu');
  if (toggle && links) {
    const close = () => {toggle.setAttribute('aria-expanded','false'); links.classList.remove('open');};
    toggle.addEventListener('click', () => {
      const opened = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded',String(!opened));
      links.classList.toggle('open',!opened);
    });
    links.querySelectorAll('a').forEach(a => a.addEventListener('click',close));
    document.addEventListener('keydown',e => {if(e.key==='Escape') close();});
    document.addEventListener('click',e => {if (!toggle.contains(e.target as Node) && !links.contains(e.target as Node)) close();});
  }
</script>
<style>
	@import url('https://fonts.googleapis.com/css2?family=Pacifico&display=swap');
  @import url('https://fonts.googleapis.com/css2?family=Great+Vibes&display=swap');
  .site-header {background:#fff; box-shadow:0 2px 8px rgba(30,30,30,.06); position:relative; z-index:20;}
  .site-nav {max-width:1450px; margin:auto; padding:12px 22px; display:flex; align-items:center; gap:18px; flex-wrap:wrap; justify-content:space-between;}
  .site-brand {margin:0; font-size:1rem; flex-shrink:0;}
  .site-brand a {font-family:'Great Vibes',cursive; font-size:40px; font-weight:400; color:#222; text-decoration:none; white-space:nowrap;}
  .menu-links {display:flex; flex:1; flex-wrap:wrap; justify-content:flex-end; align-items:center; gap:4px 10px;}
  .menu-links a {font-size:.88rem; padding:9px 8px; border-radius:9px; text-decoration:none; color:#454047; transition:background .2s,color .2s; white-space:nowrap;}
  .menu-links a:hover,.menu-links a:focus-visible {background:#fff0f3;color:#9b6175;}
  .menu-links a.active {background:#fff0f3; color:#995d71; font-weight:700;}
  .menu-toggle {display:none; border:0; background:transparent; padding:10px; cursor:pointer;}
  .menu-toggle span {display:block;width:24px;height:2px;background:#5d4550;margin:5px 0;border-radius:2px;}
  @media(max-width:1100px) {
    .site-nav {flex-wrap:nowrap;}
    .menu-toggle {display:block; margin-left:auto;}
    .menu-links {display:none; position:absolute; top:100%;left:0;right:0; background:#fff; padding:12px 20px 22px; box-shadow:0 10px 18px rgba(0,0,0,.09); max-height:75vh; overflow-y:auto;}
    .menu-links.open {display:flex;flex-direction:column;align-items:stretch;gap:4px;}
    .menu-links a {white-space:normal; padding:12px 14px;}
  }
  @media(max-width:430px){.site-brand a{font-size:27px}.site-nav{padding:10px 12px}}
/* Font Pacifico cho 7 mục menu */
.menu-links a {
    font-family: 'Pacifico', cursive;
    font-size: 18px;
    font-weight: 400;
}

/* Giữ font đồng nhất khi mục menu đang được chọn */
.menu-links a.active {
    font-weight: 400;
}
</style>
