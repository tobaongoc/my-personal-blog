
---
import SectionLayout from '../../layouts/SectionLayout.astro';
import { pathFor } from '../../data/navigation';

const years = [
  {
    year: '2027',
    icon: '🌱',
    description: 'Những câu chuyện đang chờ được viết.',
  },
  {
    year: '2026',
    icon: '🇨🇭',
    description: 'Ước mơ nhỏ thành hiện thực.',
  },
  {
    year: '2025',
    icon: '💗',
    description: 'Năm của những yêu thương.',
  },
  {
    year: '2024',
    icon: '💔',
    description: 'Cái giá của sự trưởng thành',
  },
];
---

<SectionLayout title="📖 Nhật ký của Nie" description="">
  <section class="diary-page">

    <!-- PHẦN GIỚI THIỆU -->

    <div class="diary-intro">
      <p>
        Một cuốn nhật ký theo tháng, theo năm —<br />
        để sau này nhìn lại tớ biết mình đã lớn lên thế nào.
      </p>
    </div>

    <!-- BIỂU TƯỢNG TRANG TRÍ -->

    <div class="diary-decoration" aria-hidden="true">
      ✨ 📖 🌷 ✨
    </div>

    <!-- ĐƯỜNG PHÂN CÁCH -->

    <div class="section-divider" aria-hidden="true">
      <span></span>
      <span>🌸</span>
      <span></span>
    </div>

    <!-- DANH SÁCH NHẬT KÝ THEO NĂM -->

    <section class="diary-grid" aria-label="Nhật ký theo năm">
      {years.map((item) => (
        <a
          class="diary-card"
          href={pathFor(`nhat-ky/${item.year}`)}
        >
          <span class="card-icon" aria-hidden="true">
            {item.icon}
          </span>

          <h2>{item.year}</h2>

          <p>{item.description}</p>

          <span class="card-arrow" aria-hidden="true">
            Khám phá →
          </span>
        </a>
      ))}
    </section>

    <!-- CUỐI TRANG -->

    <div class="diary-footer">
      <div class="footer-decoration" aria-hidden="true">
        🌸 ✨ 🌸
      </div>

      <a class="back-link" href={pathFor('')}>
        ← Trở lại Trang chủ
      </a>
    </div>

  </section>
</SectionLayout>

<style>
  /* KHUNG TRANG */

  .diary-page {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
  }

  /* PHẦN GIỚI THIỆU */

  .diary-intro {
    max-width: 1100px;
    margin: 0 auto 32px;
    text-align: center;
  }

  .diary-intro p {
    font-family: 'Playwrite FR Moderne', cursive;
    font-size: 18px;
    font-weight: 400;
    line-height: 2.2;
    color: #555555;
    margin: 0;
  }

  /* BIỂU TƯỢNG TRANG TRÍ */

  .diary-decoration {
    text-align: center;
    font-size: 24px;
    letter-spacing: 10px;
    margin: 0 auto 28px;
  }

  /* ĐƯỜNG PHÂN CÁCH */

  .section-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    max-width: 350px;
    margin: 0 auto 40px;
  }

  .section-divider span:first-child,
  .section-divider span:last-child {
    height: 1px;
    flex: 1;
    background: #e9cfd8;
  }

  .section-divider span:nth-child(2) {
    font-size: 23px;
  }

  /* LƯỚI NHẬT KÝ */

  .diary-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
    align-items: stretch;
  }

  /* THẺ NHẬT KÝ */

  .diary-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 260px;
    padding: 32px 24px 26px;
    background: #fff7f9;
    border: 1px solid #f1dfe5;
    border-radius: 20px;
    text-align: center;
    text-decoration: none;

    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease,
      background 0.25s ease;
  }

  .diary-card:hover {
    transform: translateY(-5px);
    background: #fff1f5;
    box-shadow: 0 10px 28px rgba(120, 70, 90, 0.1);
  }

  .diary-card:focus-visible {
    outline: 3px solid #a26c7e;
    outline-offset: 4px;
  }

  /* BIỂU TƯỢNG TRÊN THẺ */

  .card-icon {
    font-size: 34px;
    line-height: 1.4;
    margin-bottom: 20px;
    transition: transform 0.25s ease;
  }

  .diary-card:hover .card-icon {
    transform: scale(1.12) rotate(-5deg);
  }

  /* NĂM */

  .diary-card h2 {
    font-family: 'Pacifico', cursive;
    font-size: 29px;
    font-weight: 400;
    color: #704b5b;
    margin: 0 0 16px;
  }

  /* MÔ TẢ */

  .diary-card p {
    font-family: 'Playwrite FR Moderne', cursive;
    font-size: 16px;
    font-weight: 400;
    line-height: 2;
    color: #555555;
    margin: 0 0 22px;
  }

  /* LIÊN KẾT KHÁM PHÁ */

  .card-arrow {
    margin-top: auto;
    font-family: 'Playwrite FR Moderne', cursive;
    font-size: 13px;
    color: #a26c7e;
    transition: transform 0.2s ease;
  }

  .diary-card:hover .card-arrow {
    transform: translateX(4px);
  }

  /* CUỐI TRANG */

  .diary-footer {
    margin: 44px auto 28px;
    text-align: center;
  }

  .footer-decoration {
    font-size: 20px;
    letter-spacing: 10px;
    margin-bottom: 24px;
  }

  /* LIÊN KẾT TRỞ LẠI */

  .back-link {
    display: inline-block;
    font-family: Arial, sans-serif;
    font-size: 17px;
    font-weight: 500;
    color: #a26c7e;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .back-link:hover {
    color: #704b5b;
  }

  .back-link:focus-visible {
    outline: 2px solid #a26c7e;
    outline-offset: 5px;
  }

  /* TABLET */

  @media (max-width: 900px) {
    .diary-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* ĐIỆN THOẠI */

  @media (max-width: 640px) {
    .diary-grid {
      grid-template-columns: 1fr;
    }

    .diary-intro p {
      font-size: 16px;
      line-height: 2;
    }

    .diary-card {
      min-height: 230px;
      padding: 28px 20px;
    }

    .diary-decoration {
      font-size: 20px;
      letter-spacing: 5px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .diary-card,
    .card-icon,
    .card-arrow {
      transition: none;
    }
  }
</style>
